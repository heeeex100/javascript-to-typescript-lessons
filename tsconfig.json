{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["examples/ts/**/*.ts", "project/**/*.ts", "exercises/**/*.ts", "answers/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
